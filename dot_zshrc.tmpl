# ─────────────────────────────────────────────
# Oh My Zsh
# ─────────────────────────────────────────────

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="robbyrussell"

plugins=(git)

# Enable optional Oh My Zsh plugins only if installed
[[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-autosuggestions" ]] && plugins+=(zsh-autosuggestions)
[[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting" ]] && plugins+=(zsh-syntax-highlighting)

if [[ -s "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# ─────────────────────────────────────────────
# Helpers
# ─────────────────────────────────────────────

path_prepend() {
  [[ -d "$1" ]] && [[ ":$PATH:" != *":$1:"* ]] && export PATH="$1:$PATH"
}

path_append() {
  [[ -d "$1" ]] && [[ ":$PATH:" != *":$1:"* ]] && export PATH="$PATH:$1"
}

# ─────────────────────────────────────────────
# Homebrew/Linuxbrew
# Works on Bazzite and Ubuntu if Homebrew is installed.
# ─────────────────────────────────────────────

if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# ─────────────────────────────────────────────
# PATH
# ─────────────────────────────────────────────

path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.opencode/bin"

# Flutter
path_prepend "$HOME/Applications/flutter/bin"

# Android SDK
if [[ -d "$HOME/Applications/android-sdk" ]]; then
  export ANDROID_HOME="$HOME/Applications/android-sdk"
  export ANDROID_SDK_ROOT="$ANDROID_HOME"
  path_prepend "$ANDROID_HOME/platform-tools"
  path_prepend "$ANDROID_HOME/cmdline-tools/latest/bin"
fi

# Bun
if [[ -s "$HOME/.bun/_bun" ]]; then
  source "$HOME/.bun/_bun"
fi

if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  path_prepend "$BUN_INSTALL/bin"
fi

# LM Studio
path_append "$HOME/.lmstudio/bin"

# ─────────────────────────────────────────────
# Java
# Prefer Homebrew OpenJDK 21 if available.
# Fallback to system Java/Javac if installed.
# ─────────────────────────────────────────────

if command -v brew >/dev/null 2>&1 && brew --prefix openjdk@21 >/dev/null 2>&1; then
  export JAVA_HOME="$(brew --prefix openjdk@21)"
  path_prepend "$JAVA_HOME/bin"
elif command -v javac >/dev/null 2>&1; then
  export JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"
fi

# ─────────────────────────────────────────────
# Browser
# Bazzite usually uses Flatpak Chrome.
# Ubuntu may use google-chrome/chromium from PATH.
# ─────────────────────────────────────────────

if [[ -x /var/lib/flatpak/exports/bin/com.google.Chrome ]]; then
  export CHROME_EXECUTABLE="/var/lib/flatpak/exports/bin/com.google.Chrome"
elif [[ -x "$HOME/.local/share/flatpak/exports/bin/com.google.Chrome" ]]; then
  export CHROME_EXECUTABLE="$HOME/.local/share/flatpak/exports/bin/com.google.Chrome"
elif command -v google-chrome >/dev/null 2>&1; then
  export CHROME_EXECUTABLE="$(command -v google-chrome)"
elif command -v chromium >/dev/null 2>&1; then
  export CHROME_EXECUTABLE="$(command -v chromium)"
fi

# ─────────────────────────────────────────────
# Local OpenAI-compatible endpoint
# Not secret. Can be overridden in ~/.zshrc.local.
# ─────────────────────────────────────────────

export OPENAI_BASE_URL="${OPENAI_BASE_URL:-http://127.0.0.1:11434/v1}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"

# ─────────────────────────────────────────────
# Aliases
# ─────────────────────────────────────────────

if command -v flatpak >/dev/null 2>&1; then
  alias protontricks='flatpak run com.github.Matoking.protontricks'
  alias protontricks-launch='flatpak run --command=protontricks-launch com.github.Matoking.protontricks'
fi

# ─────────────────────────────────────────────
# CLI integrations
# ─────────────────────────────────────────────

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh --cmd cd)"
fi

if command -v fzf >/dev/null 2>&1; then
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  elif [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
    source /usr/share/doc/fzf/examples/key-bindings.zsh
    [[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
  elif [[ -f /usr/share/fzf/shell/key-bindings.zsh ]]; then
    source /usr/share/fzf/shell/key-bindings.zsh
    [[ -f /usr/share/fzf/shell/completion.zsh ]] && source /usr/share/fzf/shell/completion.zsh
  fi
fi

# ─────────────────────────────────────────────
# Machine-local overrides
# Keep this file private and outside chezmoi/git.
# ─────────────────────────────────────────────

if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
